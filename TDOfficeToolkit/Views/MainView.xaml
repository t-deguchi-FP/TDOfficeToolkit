<YK:Window x:Class="TDOfficeToolkit.Views.MainView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:TDOfficeToolkit.Views"
           xmlns:YK="clr-namespace:YKToolkit.Controls;assembly=YKToolkit.Controls"
           mc:Ignorable="d"
           Title="TDOfficeToolkit" Height="700" Width="850"
           IsClosingConfirmationEnabled="False"
           WindowStartupLocation="CenterScreen"
           ResizeMode="NoResize">

  <DockPanel>
    <!-- メニューバー -->
    <Menu DockPanel.Dock="Top" VerticalAlignment="Top">
      <MenuItem Header="ツール一覧">
        <MenuItem Header="Knighthead 申込書作成" Command="{Binding OpenKnightheadCommand}"/>
        <MenuItem Header="確認書作成" Command="{Binding OpenConfirmationCommand}"/>
        <Separator/>
        <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="ヘルプ">
        <MenuItem Header="バージョン情報" Command="{Binding ShowVersionCommand}"/>
      </MenuItem>
    </Menu>

    <!-- メインコンテンツエリア -->
    <Grid DockPanel.Dock="Bottom">
      <!-- ヘッダーエリア（画像またはアイコン付き） -->
      <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
        <TextBlock Text="TDOfficeToolkit" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>
        <TextBlock Text="ツールを選択してください" 
                   FontSize="12" 
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"/>
      </StackPanel>

      <!-- メインツールボタン（中央） -->
      <StackPanel Orientation="Vertical" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  Margin="0,40,0,0">

        <!-- Knightheadボタン（アイコン付き） -->
        <Button Command="{Binding OpenKnightheadCommand}"
                Width="600" 
                Height="150"
                Margin="5"
                HorizontalContentAlignment="Left">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
            <Image Source="../Resources/Knighthead.jpg" Width="130" Height="130" Margin="0,0,25,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Knighthead 申込書作成" 
                         FontSize="20" 
                         FontWeight="SemiBold"/>
              <TextBlock Text="申請書、デューデリジェンス、その他証明書を作成します。" 
                         FontSize="12" 
                         Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <!-- 確認書作成ボタン（アイコン付き） -->
        <Button Command="{Binding OpenConfirmationCommand}"
                Width="600" 
                Height="150"
                Margin="5"
                HorizontalContentAlignment="Left">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
            <Image Source="../Resources/SP500.png" Width="130" Height="130" Margin="0,0,25,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="確認書作成" 
                         FontSize="20" 
                         FontWeight="SemiBold"/>
              <TextBlock Text="各保険会社、各商品の確認書を作成します。" 
                         FontSize="12" 
                         Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- バージョン情報ボタン（右下に特別配置） -->
      <Button Content="ℹ️ バージョン情報" 
              Command="{Binding ShowVersionCommand}"
              Width="160" 
              Height="45" 
              FontSize="13"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="10"
              ToolTip="アプリケーションのバージョン情報を表示します"/>
    </Grid>
  </DockPanel>
</YK:Window>
