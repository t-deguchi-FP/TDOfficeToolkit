<YK:Window x:Class="TDOfficeToolkit.Views.KnightheadView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:TDOfficeToolkit.Views"
           xmlns:YK="clr-namespace:YKToolkit.Controls;assembly=YKToolkit.Controls"
           xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
           mc:Ignorable="d"
           Title="Knighthead 申込書作成" Height="820" Width="1450"
           IsClosingConfirmationEnabled="False"
           WindowStartupLocation="CenterScreen"
           ResizeMode="CanResize">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左側: 入力フォームエリア -->
    <Grid Grid.Column="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
          
          <!-- Trust Participant セクション -->
          <Border Padding="15" Margin="0,0,0,15">
            <StackPanel>
              <TextBlock Text="Trust Participant" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
              
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LastName -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Last Name" Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding TrustParticipant.LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- FirstName -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="First Name" Margin="0,0,0,5"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding TrustParticipant.FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Address -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Address" Margin="0,0,0,5"/>
                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding TrustParticipant.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- City -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="City" Margin="0,0,0,5"/>
                <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding TrustParticipant.City, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Country -->
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Country" Margin="0,0,0,5"/>
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding TrustParticipant.Country, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- PostalCode -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Postal Code" Margin="0,0,0,5"/>
                <TextBox Grid.Row="7" Grid.Column="0" Text="{Binding TrustParticipant.PostalCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Gender -->
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Gender" Margin="0,0,0,5"/>
                <ComboBox Grid.Row="7" Grid.Column="2" SelectedItem="{Binding TrustParticipant.Gender}" Margin="0,0,0,10" Padding="5">
                  <ComboBoxItem Content="Male"/>
                  <ComboBoxItem Content="Female"/>
                  <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Phone -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Phone" Margin="0,0,0,5"/>
                <TextBox Grid.Row="9" Grid.Column="0" Text="{Binding TrustParticipant.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- Email -->
                <TextBlock Grid.Row="8" Grid.Column="2" Text="Email" Margin="0,0,0,5"/>
                <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding TrustParticipant.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- TaxIdentificationNumber -->
                <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Text="Tax Identification Number" Margin="0,0,0,5"/>
                <TextBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding TrustParticipant.TaxIdentificationNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

                <!-- DateOfIssue -->
                <TextBlock Grid.Row="12" Grid.Column="0" Text="Date of Issue" Margin="0,0,0,5"/>
                <DatePicker Grid.Row="13" Grid.Column="0" SelectedDate="{Binding TrustParticipant.DateOfIssue}" Margin="0,0,0,10" Padding="5"/>

                <!-- ExpirationDate -->
                <TextBlock Grid.Row="12" Grid.Column="2" Text="Expiration Date" Margin="0,0,0,5"/>
                <DatePicker Grid.Row="13" Grid.Column="2" SelectedDate="{Binding TrustParticipant.ExpirationDate}" Margin="0,0,0,10" Padding="5"/>
              </Grid>
              
              <TextBlock Text="Name of Employer" Margin="0,0,0,5"/>
              <TextBox Text="{Binding TrustParticipant.NameOfEmployer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Position -->
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Position" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding TrustParticipant.Position, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <!-- BusinessPhone -->
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Business Phone" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding TrustParticipant.BusinessPhone, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Funding Account セクション -->
          <Border Padding="15" Margin="0,0,0,15">
            <StackPanel>
              <TextBlock Text="Funding Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

              <TextBlock Text="Financial Institution Name" Margin="0,0,0,5"/>
              <TextBox Text="{Binding FundingAccount.FinancialInstitutionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

              <TextBlock Text="Street" Margin="0,0,0,5"/>
              <TextBox Text="{Binding FundingAccount.Street, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="City" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding FundingAccount.City, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Country" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding FundingAccount.Country, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Postal Code" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding FundingAccount.PostalCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Swift Code" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding FundingAccount.SwiftCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="Client Account Number" Margin="0,0,0,5"/>
              <TextBox Text="{Binding FundingAccount.ClientAccountNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </StackPanel>
          </Border>

          <!-- Primary Beneficiary セクション -->
          <Border Padding="15" Margin="0,0,0,15">
            <StackPanel>
              <TextBlock Text="Primary Beneficiary" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Last Name" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding PrimaryBeneficiary.LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="First Name" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding PrimaryBeneficiary.FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Date of Birth" Margin="0,0,0,5"/>
                  <DatePicker SelectedDate="{Binding PrimaryBeneficiary.DateOfBirth}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Relationship" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding PrimaryBeneficiary.Relationship, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Product Selections セクション -->
          <Border Padding="15" Margin="0,0,0,15">
            <StackPanel>
              <TextBlock Text="Product Selections" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Number of Years" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding ProductSelections.NumberOfYears, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Amount ($)" Margin="0,0,0,5"/>
                  <TextBox Text="{Binding ProductSelections.Amount, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 分割線 -->
    <GridSplitter Grid.Column="1" 
                  Width="5"
                  HorizontalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"/>

    <!-- 右側: PDFビューアー -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- PDFコントロールバー -->
      <Border Padding="10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="📄 PDFプレビュー" 
                     FontSize="14"
                     VerticalAlignment="Center"
                     Margin="0,0,20,0"/>
          <Button Content="PDFを開く" 
                  Command="{Binding OpenPdfCommand}"
                  Padding="10,5"
                  Margin="0,0,10,0"/>
          <TextBlock Text="{Binding CurrentPdfPath, StringFormat='ファイル: {0}'}" 
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"/>
        </StackPanel>
      </Border>

      <!-- WebView2 PDFビューアー -->
      <wv2:WebView2 Grid.Row="1" 
                    x:Name="PdfWebView"
                    Source="{Binding PdfSource}"/>
    </Grid>
  </Grid>
</YK:Window>
