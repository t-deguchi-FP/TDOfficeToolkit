<YK:Window x:Class="TDOfficeToolkit.Views.MainView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:TDOfficeToolkit.Views"
           xmlns:YK="clr-namespace:YKToolkit.Controls;assembly=YKToolkit.Controls"
           mc:Ignorable="d"
           Title="TDOfficeToolkit" Height="300" Width="450"
           IsClosingConfirmationEnabled="False"
           WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- メニューバー -->
    <Menu DockPanel.Dock="Top" VerticalAlignment="Top">
      <MenuItem Header="ツール一覧">
        <MenuItem Header="Knighthead 申込書作成" Command="{Binding OpenKnightheadCommand}"/>
        <MenuItem Header="確認書作成" Command="{Binding OpenConfirmationCommand}"/>
        <Separator/>
        <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="ヘルプ">
        <MenuItem Header="バージョン情報" Command="{Binding ShowVersionCommand}"/>
      </MenuItem>
    </Menu>

    <!-- メインコンテンツエリア -->
    <Grid DockPanel.Dock="Bottom">
      <!-- メインツールボタン（中央） -->
      <StackPanel Orientation="Vertical" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center">

        <Button Content="Knighthead 申込書作成" 
                Command="{Binding OpenKnightheadCommand}"
                Width="250" 
                Height="50" 
                FontSize="14"
                Margin="5"/>

        <Button Content="確認書作成" 
                Command="{Binding OpenConfirmationCommand}"
                Width="250" 
                Height="50" 
                FontSize="14"
                Margin="5"/>
      </StackPanel>

      <!-- バージョン情報ボタン（右下に特別配置） -->
      <Button Content="ℹ️ バージョン情報" 
              Command="{Binding ShowVersionCommand}"
              Width="130" 
              Height="35" 
              FontSize="11"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="5"
              ToolTip="アプリケーションのバージョン情報を表示します"/>
    </Grid>
  </DockPanel>
</YK:Window>
